{
    "$schema": "http://json-schema.org/schema#",
    "type": "object",
    "properties": {
        "backupJob": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "forceInitRsync": {
                    "type": "boolean"
                },
                "nfsServer": {
                    "type": "string"
                },
                "nfsShare": {
                    "type": "string"
                },
                "schedule": {
                    "type": "string"
                }
            }
        },
        "containerSecurityContext": {
            "type": "object",
            "properties": {
                "allowPrivilegeEscalation": {
                    "type": "boolean"
                },
                "capabilities": {
                    "type": "object",
                    "properties": {
                        "drop": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                },
                "readOnlyRootFilesystem": {
                    "type": "boolean"
                }
            }
        },
        "dataVolume": {
            "type": "object",
            "properties": {
                "mounts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "mountPath": {
                                "type": "string"
                            }
                        }
                    }
                },
                "size": {
                    "type": "string"
                }
            }
        },
        "env": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "value": {
                        "type": "string"
                    }
                }
            }
        },
        "extraEnv": {
            "type": "array"
        },
        "extraVolumes": {
            "type": "array"
        },
        "extraVolumesMounts": {
            "type": "array"
        },
        "fullnameOverride": {
            "type": "string"
        },
        "gameFilesVolume": {
            "type": "object",
            "properties": {
                "enabled": {
                    "type": "boolean"
                },
                "mounts": {
                    "type": "array",
                    "items": {
                        "type": "object",
                        "properties": {
                            "mountPath": {
                                "type": "string"
                            }
                        }
                    }
                },
                "size": {
                    "type": "string"
                }
            }
        },
        "image": {
            "type": "object",
            "properties": {
                "digest": {
                    "type": "string"
                },
                "pullPolicy": {
                    "type": "string"
                },
                "registry": {
                    "type": "string"
                },
                "repository": {
                    "type": "string"
                },
                "tag": {
                    "type": "string"
                }
            }
        },
        "nameOverride": {
            "type": "string"
        },
        "nodeSelector": {
            "type": "object"
        },
        "podSecurityContext": {
            "type": "object",
            "properties": {
                "fsGroup": {
                    "type": "integer"
                },
                "seccompProfile": {
                    "type": "object",
                    "properties": {
                        "type": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "priorityClassName": {
            "type": "string"
        },
        "resources": {
            "type": "object",
            "properties": {
                "limits": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                },
                "requests": {
                    "type": "object",
                    "properties": {
                        "cpu": {
                            "type": "string"
                        },
                        "memory": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "service": {
            "type": "object",
            "properties": {
                "ports": {
                    "type": "array"
                },
                "sessionAffinity": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                }
            }
        },
        "tolerations": {
            "type": "object"
        }
    }
}
